datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//-------------------------------------------
//* USER MODEL 
//-------------------------------------------

model User {
  id String @id @default(uuid())

  username String @unique
  fullName String
  password String
  role     String

  pageAccess String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_User")
}

//-------------------------------------------
//* STAGE 1: INDENT GENERATION
//-------------------------------------------
model IndentGeneration {
  id        String   @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())

  indentNo          String  @unique
  createdBy         String?
  category          String?
  itemName          String?
  quantity          Float?
  warehouseLocation String?
  itemCode          String?
  leadTime          Int?
  uom               String?
  attachment        String?
  status            String  @default("pending")
  remarks           String?

  plannedIndentApproval DateTime?

  // Relation fields
  approval       IndentApproval?
  update3Vendors Update3Vendors?
  negotiation    Negotiation?
  poEntry        POEntry?
  lifts          Lift[]
  pfmsForIms     PfmsForIms?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_indent_generation")
}

//-------------------------------------------
//* STAGE 2: INDENT APPROVAL
//-------------------------------------------
model IndentApproval {
  id        String   @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())

  indentNo String           @unique
  indent   IndentGeneration @relation(fields: [indentNo], references: [indentNo], onDelete: Cascade)

  status      String  @default("pending")
  approvedQty Float?
  vendorType  String?
  remarks     String?
  imgOptional String?
  approvedBy  String?

  plannedUpdateVendors DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_indent-approval")
}

//-------------------------------------------
//* STAGE 3: UPDATE 3 VENDORS
//-------------------------------------------
model Update3Vendors {
  id        String   @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())

  indentNo String           @unique
  indent   IndentGeneration @relation(fields: [indentNo], references: [indentNo], onDelete: Cascade)

  // Vendor 1
  vendor1Name         String?
  vendor1Rate         Float?
  vendor1Terms        String?
  vendor1DeliveryDate DateTime?
  vendor1WarrantyType String?
  vendor1WarrantyFrom DateTime?
  vendor1WarrantyTo   DateTime?
  vendor1Attachment   String?

  // Vendor 2
  vendor2Name         String?
  vendor2Rate         Float?
  vendor2Terms        String?
  vendor2DeliveryDate DateTime?
  vendor2WarrantyType String?
  vendor2WarrantyFrom DateTime?
  vendor2WarrantyTo   DateTime?
  vendor2Attachment   String?

  // Vendor 3
  vendor3Name         String?
  vendor3Rate         Float?
  vendor3Terms        String?
  vendor3DeliveryDate DateTime?
  vendor3WarrantyType String?
  vendor3WarrantyFrom DateTime?
  vendor3WarrantyTo   DateTime?
  vendor3Attachment   String?

  plannedNegotiation DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_update-3-vendors")
}

//-------------------------------------------
//* STAGE 4: NEGOTIATION
//-------------------------------------------
model Negotiation {
  id        String   @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())

  indentNo String           @unique
  indent   IndentGeneration @relation(fields: [indentNo], references: [indentNo], onDelete: Cascade)

  selectedVendorName String?
  finalApprovedBy    String?
  negotiationRemarks String?

  plannedPOEntry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_negotiation")
}

//-------------------------------------------
//* STAGE 5: PO ENTRY
//-------------------------------------------
model POEntry {
  id        String   @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())

  indentNo String           @unique
  indent   IndentGeneration @relation(fields: [indentNo], references: [indentNo], onDelete: Cascade)

  poNumber     String?
  basicValue   Float?
  totalWithTax Float?
  hsn          String?
  poCopy       String?
  gst          String?
  pkgAmount    Float?
  pkgGST       String?

  plannedFollowUpVendor   DateTime?
  estimatedFollowUpVendor DateTime?
  remarksFollowUpVendor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_po-entry")
}

//-------------------------------------------
//* STAGE 6: FOLLOW-UP VENDOR
//-------------------------------------------
model Lift {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  liftNo    String   @unique

  indentNo String
  indent   IndentGeneration @relation(fields: [indentNo], references: [indentNo], onDelete: Cascade)

  liftingQty      Float
  transporterName String?
  vehicleNo       String?
  contactNo       String?
  lrNo            String?
  dispatchDate    DateTime?
  freightAmount   Float?
  advanceAmount   Float?
  paymentDate     DateTime?
  paymentStatus   String?
  biltyCopy       String?
  followUpDate    DateTime?
  remarks         String?

  // Vendor follow-up merged fields
  estimatedDate   DateTime?
  remarksFollowUp String?

  // Stage outputs (next stages planned dates)
  plannedSerialGen        DateTime?
  plannedMaterialRcd      DateTime?
  plannedTransporterFlwUp DateTime?

  // Relation fields
  transporterFollowUp   TransporterFollowUp?
  materialReceived      MaterialReceived?
  materialTestings      MaterialTesting[]
  purchaseReturns       PurchaseReturn[]
  returnApprovals       ReturnApproval[]
  serials               SerialNumber[]
  tallyEntry            TallyEntry?
  submitInvoiceHO       SubmitInvoiceHO?
  submitInvoice         SubmitInvoice?
  accountsVerification  AccountsVerification?
  vendorPaymentDetails  VendorPaymentDetails?
  freightPaymentDetails FreightPaymentDetails?
  damagedRecord         DamagedRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_lift")
}

//-------------------------------------------
//* STAGE 6.1: TRANSPORTER FOLLOW-UP
//-------------------------------------------
model TransporterFollowUp {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  status               String
  expectedDeliveryDate DateTime?
  nextFollowUpDate     DateTime?
  remarks              String?
  lastFollowUpDate     DateTime?
  totalFollowUps       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_transporter-follow-up")
}

//-------------------------------------------
//* STAGE 7: MATERIAL RECEIVED
//-------------------------------------------
model MaterialReceived {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  // Invoice & Receipt Data
  invoiceType       String
  invoiceNumber     String
  invoiceDate       DateTime
  receivedQty       Float
  receivedItemImage String?
  billAttachment    String?
  qcRequired        String

  // Destination Handling Charges
  extraFreight Float?
  hydraAmt     Float?
  labourAmt    Float?
  hamaliAmt    Float?

  // Damage Logs (if any)
  damagedQty   Float?
  damageReason String?
  damageImage  String?

  plannedMaterialTesting DateTime?
  plannedTallyEntry      DateTime?

  // Warranty & Product Expiry
  productExpiry     String?
  productExpiryDate DateTime?
  warranty          String?
  warrantyDuration  Int?
  warrantyExpiry    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_material-received")
}

//-------------------------------------------
//* STAGE 7.1: DAMAGED RECORDS
//-------------------------------------------
model DamagedRecord {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_damaged-record")
}

//-------------------------------------------
//* STAGE 7.5: SERIAL GENERATION
//-------------------------------------------
model SerialNumber {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  serialNo       String    @unique
  qrLink         String?
  warrantyExpiry DateTime?
  productExpiry  DateTime?

  // Relation fields
  warrantyClaim WarrantyClaim?

  plannedWarrantyClaim DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_serial-number")
}

//-------------------------------------------
//* STAGE 7.6: WARRANTY CLAIM
//-------------------------------------------
model WarrantyClaim {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  serialNo     String       @unique
  serialNumber SerialNumber @relation(fields: [serialNo], references: [serialNo], onDelete: Cascade)

  // Claim Details
  invoiceNo        String?
  invoiceCopy      String?
  issueDescription String
  photoVideo       String?
  claimType        String
  status           String  @default("Pending")
  claimedBy        String?

  // Closure Details
  plannedClosure DateTime?
  closureDate    DateTime?
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_warranty-claim")
}

//-------------------------------------------
//* STAGE 8: RECEIPT IN TALLY
//-------------------------------------------
model TallyEntry {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  doneBy        String
  doneDate      DateTime?
  remarks       String?
  checkedStatus String
  checkedByAcc  String?

  plannedInvoiceHO DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_tally-entry")
}

//-------------------------------------------
//* STAGE 8.5: SUBMIT INVOICE TO HO
//-------------------------------------------
model SubmitInvoiceHO {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  hardcopySubmitted String
  submissionDate    DateTime

  plannedInvoice DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_submit-invoice-ho")
}

//-------------------------------------------
//* STAGE 9: SUBMIT INVOICE
//-------------------------------------------
model SubmitInvoice {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  handoverBy            String
  invoiceSubmissionDate DateTime

  plannedVerification DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_submit-invoice")
}

//-------------------------------------------
//* STAGE 10: VERIFICATION BY ACCOUNTS
//-------------------------------------------
model AccountsVerification {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  verifiedCheckedBy String
  verificationDate  DateTime
  remarks           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_accounts-verification")
}

//-------------------------------------------
//* STAGE 11: MATERIAL TESTING
//-------------------------------------------
model MaterialTesting {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  qcBy             String?
  qcDate           DateTime?
  workingCondition String?
  remarks          String?

  pendingQty    Float?
  approvedQty   Float?
  checklist     String[]
  serialNumbers String[]
  images        String[]

  rejectType  String?
  partName    String?
  rejectedQty Float?

  plannedPurchaseReturns DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_material-testing")
}

//-------------------------------------------
//* STAGE 11.5: PURCHASE RETURN
//-------------------------------------------
model PurchaseReturn {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  returnedQty     Float
  returnRate      Float?
  returnAmount    Float?
  returnReason    String?
  returnStatus    String
  returnItemImage String?
  creditNoteImage String?

  plannedReturnApproval DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_purchase-return")
}

//-------------------------------------------
//* STAGE 12: RETURN APPROVAL
//-------------------------------------------
model ReturnApproval {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  dnNumber     String
  remarks      String?
  returnImage  String
  approvalDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_return-approval")
}

//-------------------------------------------
//* STAGE 13: VENDOR PAYMENT DETAILS (1-to-1 with Lift)
//-------------------------------------------
model VendorPaymentDetails {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  totalAmount Float
  paidAmount  Float     @default(0)
  dueDate     DateTime?
  plannedDate DateTime?

  // Relation to individual payments history
  paymentLogs PaidData[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_vendor-payment-details")
}

//-------------------------------------------
//* PAID DATA (Many-to-1 with Invoice)
//-------------------------------------------
model PaidData {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  invoiceId     String
  vendorInvoice VendorPaymentDetails @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Payment Transaction Details
  amountPaid    Float
  paymentStatus String
  paymentDate   DateTime
  paymentMode   String
  proof         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_paid-data")
}

//-------------------------------------------
//* STAGE 14: FREIGHT PAYMENT DETAILS (1-to-1 with Lift)
//-------------------------------------------
model FreightPaymentDetails {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  liftNo String @unique
  lift   Lift   @relation(fields: [liftNo], references: [liftNo], onDelete: Cascade)

  totalAmount Float
  paidAmount  Float     @default(0)
  plannedDate DateTime?

  // Relation to individual payments history
  paymentLogs PaidFreightData[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_freight-payment-details")
}

//-------------------------------------------
//* PAID FREIGHT DATA (Many-to-1 with Freight Details)
//-------------------------------------------
model PaidFreightData {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  freightDetailId String
  freightDetail   FreightPaymentDetails @relation(fields: [freightDetailId], references: [id], onDelete: Cascade)

  amountPaid    Float
  paymentStatus String
  paymentDate   DateTime
  paymentMode   String
  proof         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_paid-freight-data")
}

model OrderCancellation {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  indentNo     String
  poNumber     String?
  itemName     String
  cancelStage  String
  cancelReason String
  qty          Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_order-cancellation")
}

//-------------------------------------------
//* TAT (TURN AROUND TIME) CONFIGURATION
//-------------------------------------------
model TAT {
  id               String  @id @default(uuid())
  stageName        String  @unique
  actionTime       Int // Stored in hours
  responsibleNames String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pfms_tat")
}

//-------------------------------------------
//* ITEM MASTER
//-------------------------------------------
model ItemMaster {
  id String @id @default(uuid())

  itemCode     String? @map("ITEM CODE")
  itemCategory String? @map("ITEM CATEGORY")
  itemName     String? @map("ITEM NAME")
  purchaser    String?

  @@map("pfms_item_master")
}

//-------------------------------------------
//* VENDOR MASTER
//-------------------------------------------
model VendorMaster {
  id String @id @default(uuid())

  vendorCode String? @map("Vendor Code")
  vendorList String? @map("Vendor List")

  @@map("pfms_vendor-master")
}

//-------------------------------------------
//* DROPDOWN OPTIONS
//-------------------------------------------
// Normalized category/value pairs (was previously one sparse column per
// category with one new mostly-null row per added option). Categories in use:
// Created By, Wharehouse, UOM, Payment Terms (Stage3), Approved By,
// Transporter, Purchaser, Accounts, Engineers, QC-Checklist, Reject Type (QC).
// ("Checked By", "Tally Done By" and "Checkers (Verification)" were retired
// in favor of "Accounts" / "Engineers" — see sql-queries/DB_CONTEXT.md §7.)
model Dropdown {
  id String @id @default(uuid())

  category  String
  value     String
  createdAt DateTime? @default(now()) @map("createdAt")

  @@unique([category, value])
  @@map("pfms_dropdown")
}

//-------------------------------------------
//* PFMS FOR IMS
//-------------------------------------------
model PfmsForIms {
  id                String  @id @default(uuid()) @db.Uuid
  indentNo          String? @unique @map("indent no.")
  materialName      String? @map("material name")
  warehouseLocation String? @map("warehouse location")

  indentQty            Float?  @map("indent qty")
  poQty                Float?  @map("po qty")
  receivingQty         Float?  @map("receiving qty")
  expectedDeliveryDate String? @map("transport details updated - expected delivery date")
  receivingDate        String? @map("receiving date")
  tallyEntryDate       String? @map("tally entry date")
  intransitQty         Float?  @map("intransit qty")
  expiryDate           String? @map("expiry date")
  serialNumbers        String? @map("serial numbers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  indent IndentGeneration? @relation(fields: [indentNo], references: [indentNo], onDelete: Cascade, onUpdate: Cascade)

  @@map("pfms_for_ims")
}

//-------------------------------------------
//* REPORT HISTORY
//-------------------------------------------
model ReportHistory {
  id         String   @id @default(uuid())
  timestamp  DateTime @default(now())
  reportName String
  reportLink String

  @@map("pfms_report_history")
}

//-------------------------------------------
//* RESPONSIBLE PERSONS
//-------------------------------------------
model ResponsiblePersons {
  id              String  @id @default(uuid()) @db.Uuid
  stageName       String?
  responsibleName String?

  @@map("pfms_responsible_persons")
}

//-------------------------------------------
//* VIEW: UNIQUE INDENTS & LIFTS (pfms_view-indent-lift)
//-------------------------------------------
model PfmsViewIndentLift {
  indent_number          String    @id @map("indent_number")
  timestamp_stage1       DateTime? @map("timestamp_stage1")
  created_by             String?   @map("created_by")
  item_name              String?   @map("item_name")
  qty                    Float?    @map("qty")
  warehouse_location     String?   @map("warehouse_location")
  planned_stage2         DateTime? @map("planned_stage2")
  actual_stage2          DateTime? @map("actual_stage2")
  delay_stage2           Float?    @map("delay_stage2")
  approved_qty           Float?    @map("approved_qty")
  planned_stage3         DateTime? @map("planned_stage3")
  actual_stage3          DateTime? @map("actual_stage3")
  delay_stage3           Float?    @map("delay_stage3")
  vendor1_name           String?   @map("vendor1_name")
  vendor2_name           String?   @map("vendor2_name")
  vendor3_name           String?   @map("vendor3_name")
  planned_stage4         DateTime? @map("planned_stage4")
  actual_stage4          DateTime? @map("actual_stage4")
  delay_stage4           Float?    @map("delay_stage4")
  selected_vendor_name   String?   @map("selected_vendor_name")
  planned_stage5         DateTime? @map("planned_stage5")
  actual_stage5          DateTime? @map("actual_stage5")
  delay_stage5           Float?    @map("delay_stage5")
  po_number              String?   @map("po_number")
  planned_stage6         DateTime? @map("planned_stage6")
  actual_stage6          DateTime? @map("actual_stage6")
  delay_stage6           Float?    @map("delay_stage6")
  expected_delivery_date DateTime? @map("expected_delivery_date")
  estimated_date         DateTime? @map("estimated_date")
  remarks_follow_up      String?   @map("remarks_follow_up")

  @@map("pfms_view-indent-lift")
}

//-------------------------------------------
//* VIEW: RECEIVING ACCOUNTS (pfms_view-receiving_accounts)
//-------------------------------------------
model PfmsViewReceivingAccounts {
  lift_no                String    @id @map("lift_no")
  timestamp_lift         DateTime? @map("timestamp_lift")
  indent_no              String?   @map("indent_no")
  vendor_name            String?   @map("vendor_name")
  po_number              String?   @map("po_number")
  item_name              String?   @map("item_name")
  lifting_qty            Float?    @map("lifting_qty")
  transporter_name       String?   @map("transporter_name")
  planned_stage6_1       DateTime? @map("planned_stage6_1")
  actual_stage6_1        DateTime? @map("actual_stage6_1")
  delay_stage6_1         Float?    @map("delay_stage6_1")
  expected_delivery_date DateTime? @map("expected_delivery_date")
  planned_stage7         DateTime? @map("planned_stage7")
  actual_stage7          DateTime? @map("actual_stage7")
  delay_stage7           Float?    @map("delay_stage7")
  invoice_number         String?   @map("invoice_number")
  received_qty           Float?    @map("received_qty")
  planned_stage7_5       DateTime? @map("planned_stage7_5")
  actual_stage7_5        DateTime? @map("actual_stage7_5")
  delay_stage7_5         Float?    @map("delay_stage7_5")
  planned_stage8         DateTime? @map("planned_stage8")
  actual_stage8          DateTime? @map("actual_stage8")
  delay_stage8           Float?    @map("delay_stage8")
  tally_done_by          String?   @map("tally_done_by")
  tally_done_date        DateTime? @map("tally_done_date")
  tally_checked_by_acc   String?   @map("tally_checked_by_acc")
  planned_stage8_5       DateTime? @map("planned_stage8_5")
  actual_stage8_5        DateTime? @map("actual_stage8_5")
  delay_stage8_5         Float?    @map("delay_stage8_5")
  planned_stage9         DateTime? @map("planned_stage9")
  actual_stage9          DateTime? @map("actual_stage9")
  delay_stage9           Float?    @map("delay_stage9")
  planned_stage10        DateTime? @map("planned_stage10")
  actual_stage10         DateTime? @map("actual_stage10")
  delay_stage10          Float?    @map("delay_stage10")
  invoice_handover_by    String?   @map("invoice_handover_by")
  accounts_verified_by   String?   @map("accounts_verified_by")
  planned_stage11        DateTime? @map("planned_stage11")
  actual_stage11         DateTime? @map("actual_stage11")
  delay_stage11          Float?    @map("delay_stage11")
  testing_approved_qty   Float?    @map("testing_approved_qty")
  testing_rejected_qty   Float?    @map("testing_rejected_qty")
  planned_stage11_5      DateTime? @map("planned_stage11_5")
  actual_stage11_5       DateTime? @map("actual_stage11_5")
  delay_stage11_5        Float?    @map("delay_stage11_5")
  pr_returned_qty        Float?    @map("pr_returned_qty")
  planned_stage12        DateTime? @map("planned_stage12")
  actual_stage12         DateTime? @map("actual_stage12")
  delay_stage12          Float?    @map("delay_stage12")
  po_basic_value         Float?    @map("po_basic_value")
  po_copy                String?   @map("po_copy")
  approved_qty           Float?    @map("approved_qty")
  paid_amount            Float?    @map("paid_amount")

  @@map("pfms_view-receiving_accounts")
}
